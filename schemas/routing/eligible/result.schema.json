{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gc routing eligible --json result",
  "type": "object",
  "properties": {
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/TargetSnapshot"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "work": {
      "items": {
        "$ref": "#/$defs/EligibleWorkSnapshot"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ExecutionCandidateSnapshot"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "ok": {
      "const": true
    }
  },
  "required": [
    "observed_at",
    "work",
    "targets",
    "candidates",
    "ok"
  ],
  "$defs": {
    "EligibleWorkSnapshot": {
      "additionalProperties": false,
      "properties": {
        "claim_fence": {
          "format": "int64",
          "type": "integer"
        },
        "rig": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "work_bead_id": {
          "type": "string"
        },
        "work_revision": {
          "format": "int64",
          "type": "integer"
        },
        "work_state_digest": {
          "type": "string"
        }
      },
      "required": [
        "rig",
        "scope",
        "work_bead_id",
        "work_revision",
        "claim_fence",
        "work_state_digest"
      ],
      "type": "object"
    },
    "TargetSnapshot": {
      "additionalProperties": false,
      "properties": {
        "config_digest": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "resolved_provider": {
          "type": "string"
        },
        "rig": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "target",
        "rig",
        "description",
        "resolved_provider",
        "config_digest"
      ],
      "type": "object"
    },
    "ExecutionCandidateSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "integer" },
        "canonical_model": { "type": "string" },
        "serve_as": { "type": "string" },
        "reasoning_effort": { "type": "string" },
        "account": { "type": "string" },
        "provider": { "type": "string" },
        "target": { "type": "string" },
        "config_digest": { "type": "string" },
        "adapter_id": { "type": "string" },
        "adapter_digest": { "type": "string" },
        "invocation_digest": { "type": "string" }
      },
      "required": [
        "schema",
        "canonical_model",
        "serve_as",
        "reasoning_effort",
        "account",
        "provider",
        "target",
        "config_digest",
        "adapter_id",
        "adapter_digest",
        "invocation_digest"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false
}
