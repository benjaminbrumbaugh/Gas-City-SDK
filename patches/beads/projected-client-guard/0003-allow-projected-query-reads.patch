 	"info":             {},
 	"label":            {},
 	"list":             {},
+	"query":            {},
 	"ready":            {},
 	"release":          {},
 	"reopen":           {},
diff --git a/cmd/bd/projected_client_guard_test.go b/cmd/bd/projected_client_guard_test.go
index 11538d93..261edce8 100644
--- a/cmd/bd/projected_client_guard_test.go
+++ b/cmd/bd/projected_client_guard_test.go
@@ -31,6 +31,7 @@ func TestProjectedClientGuardAllowsIssueCommands(t *testing.T) {
 		{"close"},
 		{"dep", "add"},
 		{"list"},
+		{"query"},
 	} {
 		if err := enforceProjectedClientCommand(projectedGuardCommand(path...)); err != nil {
 			t.Errorf("%s: unexpected error: %v", strings.Join(path, " "), err)
